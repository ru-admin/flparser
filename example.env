# Переменные окружения для FL.ru Parser
# Скопируйте в /etc/flparser/env или в .env в директории проекта

# ─── Telegram ──────────────────────────────────────────────────────────────────
FL_BOT_TOKEN=your_telegram_bot_token_here
FL_CHAT_ID=your_chat_id_here
TG_PROXY=

# ─── LLM API ───────────────────────────────────────────────────────────────────
FLRU_LLM_API_KEY=your_api_key_here
FLRU_LLM_BASE_URL=https://openrouter.ai/api/v1
FLRU_AI_MODEL=openrouter/free
AI_PROXY=

# ─── Опциональные (дебаг) ──────────────────────────────────────────────────────
FLRU_DEBUG2TG=false

# ─── RSS ───────────────────────────────────────────────────────────────────────
FL_RU_RSS_URL=https://www.fl.ru/rss/all.xml
FL_PROXY=

# ─── Ограничения ───────────────────────────────────────────────────────────────
MAX_TASKS_PER_RUN=60
REQUEST_TIMEOUT=30
AI_TIMEOUT=60

# ─── Retry-политика ────────────────────────────────────────────────────────────
URL_RETRY=3
URL_DELAY=2

# ─── Настройка приоритетов ─────────────────────────────────────────────────────
PRIORITY_HIGH_THRESHOLD=80
PRIORITY_MEDIUM_THRESHOLD=60

# ─── Расписание в Docker (формат cron: минута час день месяц день_недели) ──────
CRON_PARSE=*/10 * * * *
CRON_STATS=59 23 * * *

# ─── Дополнительные заголовки для OpenRouter (опционально) ─────────────────────
# HERMES_OPENROUTER_APP_REFERER=https://your-app.example.com
# HERMES_OPENROUTER_APP_TITLE=FL.ru Parser