#!/bin/bash
# flparser — обёртка для парсера FL.ru
#
# Использование:
#   flparser              # один проход парсера и выход
#   flparser --dry-run    # только фильтрация, без AI/записи в БД
#   flparser --stats      # показать статистику

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

unset HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy

cd "$SCRIPT_DIR"
exec python3 "$SCRIPT_DIR/flparser.py" "$@"
